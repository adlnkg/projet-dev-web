model Event {
    id          Int      @id @default(autoincrement())
    price       Float   @default(0.0)  
    title       String
    description String
    createdAt   DateTime @default(now())
    organizer   String
    imageUrl    String   @default("images/events/default-event.png")

    startTime            DateTime
    endTime              DateTime
    numberOfParticipants Int
    maxParticipants      Int

    area   Area @relation("AreaEvents", fields: [areaId], references: [id], onDelete: Cascade)
    areaId Int

    owner   User?   @relation("UserCreatedEvents", fields: [ownerId], references: [id], onDelete: SetNull)
    ownerId String?

    registrations EventRegistration[] @relation("EventRegistrations")

    type EventType @default(WORKSHOP)
}

model EventRegistration {
    id        String   @id @default(uuid())
    user      User     @relation("UserEventRegistrations", fields: [userId], references: [id], onDelete: Cascade)
    userId    String
    event     Event    @relation("EventRegistrations", fields: [eventId], references: [id], onDelete: Cascade)
    eventId   Int
    createdAt DateTime @default(now())

    @@unique([userId, eventId])
}

enum EventType {
    //A remplir ...
    WORKSHOP
    CONFERENCE
    MEETING
    COURSE
}



model Actuality {
    id        Int      @id @default(autoincrement())
    title     String
    content   String

    imageUrl  String   @default("images/actualities/default-actuality.png")
    type      ActualityType @default(NEWS)
    createdAt DateTime @default(now())

    owner   User?   @relation("UserCreatedActualities", fields: [ownerId], references: [id], onDelete: SetNull)
    ownerId String?
}

enum ActualityType {
    //A remplir ...
    NEWS
    ANNOUNCEMENT
    UPDATE
    OTHER
}