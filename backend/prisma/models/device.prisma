//Table objets connectés
model IoTDevice {
    id          Int      @id @default(autoincrement())
    uniqueName  String   @unique
    name        String
    description String
    createdAt   DateTime @default(now())
    lastUpdated DateTime @default(now()) @updatedAt
    imageUrl    String   @default("images/devices/default-device.png")

    electricityConsumption Float  @default(0) // in kWh
    brand                  String
    model                  String

    status DeviceStatus @default(INACTIVE)
    active Boolean      @default(false)

    area   Area @relation("AreaDevices", fields: [areaId], references: [id], onDelete: Cascade)
    areaId Int

    owner   User?   @relation("UserCreatedDevices", fields: [ownerId], references: [id], onDelete: SetNull)
    ownerId String?

    // inheritance-like relations for device types
    type          DeviceType
    sensor        Sensor?
    whiteboard    InteractiveWhiteboard?
    light         Light?
    thermostat    Thermostat?
    camera        Camera?
    accessControl AccessControl?
}

enum DeviceType {
    //A remplir ...
    LIGHT
    SENSOR
    THERMOSTAT
    CAMERA
    ACCESS_CONTROL
    WHITEBOARD
}

enum DeviceStatus {
    ACTIVE
    INACTIVE
    DISCONNECTED
    ERROR
}

model Sensor {
    id        Int      @id @default(autoincrement())
    deviceId  Int      @unique
    timestamp DateTime @default(now())
    value     Float

    device IoTDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

model InteractiveWhiteboard {
    id         Int    @id @default(autoincrement())
    deviceId   Int    @unique
    resolution String
    screenSize Float

    device IoTDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

model Light {
    id         Int    @id @default(autoincrement())
    deviceId   Int    @unique
    brightness Int
    color      String

    device IoTDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

model Thermostat {
    id          Int            @id @default(autoincrement())
    deviceId    Int            @unique
    temperature Float
    targetTemp  Float
    mode        ThermostatMode @default(OFF)

    device IoTDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

model Camera {
    id         Int    @id @default(autoincrement())
    deviceId   Int    @unique
    resolution String
    frameRate  Float

    device IoTDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

model AccessControl {
    id       Int    @id @default(autoincrement())
    deviceId Int    @unique
    status   String

    device IoTDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

enum ThermostatMode {
    OFF
    HEAT
    COOL
    AUTO
}
