model Area {
  id          Int    @id @default(autoincrement())
  name        String
  description String

  iotDevices IoTDevice[] @relation("AreaDevices")
  events     Event[]     @relation("AreaEvents")

  parentArea   Area?  @relation("AreaHierarchy", fields: [parentAreaId], references: [id], onDelete: Cascade)
  parentAreaId Int?
  childAreas   Area[] @relation("AreaHierarchy")

  type          AreaType
  building      Building?      @relation("AreaTypeBuilding")
  floor         Floor?         @relation("AreaTypeFloor")
  classroom     Classroom?     @relation("AreaTypeClassroom")
  technicalRoom TechnicalRoom? @relation("AreaTypeTechnicalRoom")
}

enum AreaType {
  BUILDING
  FLOOR
  CLASSROOM
  TECHNICAL_ROOM
}

model Building {
  id      Int    @id @default(autoincrement())
  // name    String
  address String

  areas  Area @relation("AreaTypeBuilding", onDelete: Cascade, fields: [areaId], references: [id])
  areaId Int  @unique
}

model Floor {
  id          Int @id @default(autoincrement())
  floorNumber Int

  area   Area @relation("AreaTypeFloor", onDelete: Cascade, fields: [areaId], references: [id])
  areaId Int  @unique
}

model Classroom {
  id              Int @id @default(autoincrement())
  classroomNumber Int

  whiteboards Whiteboard[] @relation("ClassroomWhiteboards")

  area   Area @relation("AreaTypeClassroom", onDelete: Cascade, fields: [areaId], references: [id])
  areaId Int  @unique
}

model TechnicalRoom {
  id         Int @id @default(autoincrement())
  roomNumber Int

  area   Area @relation("AreaTypeTechnicalRoom", onDelete: Cascade, fields: [areaId], references: [id])
  areaId Int  @unique
}
