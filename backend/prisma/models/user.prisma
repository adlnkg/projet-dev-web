model User {
  id         String      @id @default(uuid())
  login      String      @unique
  email      String      @unique
  password   String
  lastName   String?
  firstName  String?
  sex        Sex?
  age        Int?
  role       Role
  memberType MemberType?
  avatarUrl  String?
  createdAt  DateTime    @default(now())
}

enum Sex {
  M
  F
}

enum Role {
  USER
  SUPER_USER
  ADMIN
}

enum MemberType {
  STUDENT
}
