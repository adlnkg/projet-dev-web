//Table objets connectés
model IoTDevice {
    id          Int      @id @default(autoincrement())
    uniqueName  String   @unique
    name        String
    description String
    createdAt   DateTime @default(now())
    lastUpdated DateTime @default(now()) @updatedAt
    imageUrl    String   @default("images/devices/default-device.png")

    electricityConsumption Float  @default(0) // in kWh
    nominalPowerWatts      Float  @default(0)
    averageDailyUsageHours Float  @default(0)
    maintenanceIntervalDays Int   @default(0)
    lastPowerOnAt          DateTime?
    lastPowerOffAt         DateTime?
    lastMaintenanceAt      DateTime?
    brand                  String
    model                  String

    status DeviceStatus @default(INACTIVE)
    active Boolean      @default(false)

    area   Area @relation("AreaDevices", fields: [areaId], references: [id], onDelete: Cascade)
    areaId Int

    owner   User?   @relation("UserCreatedDevices", fields: [ownerId], references: [id], onDelete: SetNull)
    ownerId String?

    // inheritance-like relations for device types
    type          DeviceType
    sensor        Sensor?
    whiteboard    InteractiveWhiteboard?
    light         Light?
    thermostat    Thermostat?
    camera        Camera?
    accessControl AccessControl?
    historyEntries IoTDeviceHistory[] @relation("IoTDeviceHistories")
}

enum DeviceType {
    //A remplir ...
    LIGHT
    SENSOR
    THERMOSTAT
    CAMERA
    ACCESS_CONTROL
    WHITEBOARD
}

enum DeviceStatus {
    ACTIVE
    INACTIVE
    DISCONNECTED
    ERROR
}

model Sensor {
    id        Int      @id @default(autoincrement())
    deviceId  Int      @unique
    timestamp DateTime @default(now())
    value     Float
    samplingIntervalSeconds Int      @default(60)
    batteryLevel            Float    @default(100)
    lastReadingAt           DateTime?

    device IoTDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

model InteractiveWhiteboard {
    id         Int    @id @default(autoincrement())
    deviceId   Int    @unique
    resolution String
    screenSize Float
    powerWatts  Float   @default(0)
    lastSwitchedOnAt  DateTime?
    lastSwitchedOffAt DateTime?

    device IoTDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

model Light {
    id         Int    @id @default(autoincrement())
    deviceId   Int    @unique
    brightness Int
    color      String
    powerWatts       Float    @default(0)
    colorTemperature  Int?
    lastSwitchedOnAt  DateTime?
    lastSwitchedOffAt DateTime?

    device IoTDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

model Thermostat {
    id          Int            @id @default(autoincrement())
    deviceId    Int            @unique
    temperature Float
    targetTemp  Float
    mode        ThermostatMode @default(OFF)
    powerWatts  Float          @default(0)
    lastHeatingAt DateTime?
    lastCoolingAt DateTime?

    device IoTDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

model Camera {
    id         Int    @id @default(autoincrement())
    deviceId   Int    @unique
    resolution String
    frameRate  Float
    powerWatts          Float    @default(0)
    streamingBitrateKbps Int      @default(0)
    lastRecordingStartedAt DateTime?
    lastRecordingStoppedAt  DateTime?

    device IoTDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

model AccessControl {
    id       Int    @id @default(autoincrement())
    deviceId Int    @unique
    status   String
    powerWatts    Float    @default(0)
    lastOpenedAt  DateTime?
    lastClosedAt  DateTime?

    device IoTDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

enum ThermostatMode {
    OFF
    HEAT
    COOL
    AUTO
}

model IoTDeviceHistory {
    id            String   @id @default(uuid())
    deviceId      Int
    kind          IoTDeviceHistoryKind
    fieldKey      String
    previousValue String?
    currentValue  String?
    numericValue  Float?
    unit          String?
    note          String?
    recordedAt    DateTime @default(now())

    device IoTDevice @relation("IoTDeviceHistories", fields: [deviceId], references: [id], onDelete: Cascade)

    @@index([deviceId, recordedAt])
    @@index([fieldKey])
}

enum IoTDeviceHistoryKind {
    SNAPSHOT
    MEASUREMENT
    STATE_CHANGE
    MAINTENANCE
    USAGE
}
