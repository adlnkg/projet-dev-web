model Event {
    id          Int      @id @default(autoincrement())
    price       Float   @default(0.0)  
    title       String
    description String
    createdAt   DateTime @default(now())
    organizer   String
    imageUrl    String   @default("images/events/default-event.png")

    startTime            DateTime
    endTime              DateTime
    numberOfParticipants Int
    maxParticipants      Int

    area   Area @relation("AreaEvents", fields: [areaId], references: [id], onDelete: Cascade)
    areaId Int

    owner   User?   @relation("UserCreatedEvents", fields: [ownerId], references: [id], onDelete: SetNull)
    ownerId String?

    type EventType @default(WORKSHOP)
}

enum EventType {
    //A remplir ...
    WORKSHOP
    CONFERENCE
    MEETING
    COURSE
}



model Actuality {
    id        Int      @id @default(autoincrement())
    title     String
    content   String

    imageUrl  String   @default("images/actualities/default-actuality.png")

    createdAt DateTime @default(now())

    owner   User?   @relation("UserCreatedActualities", fields: [ownerId], references: [id], onDelete: SetNull)
    ownerId String?
}
