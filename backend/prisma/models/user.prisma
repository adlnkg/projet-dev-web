model User {
  id           String         @id @default(uuid())
  login        String         @unique
  email        String         @unique
  password     String
  otp          String?
  otpExpires   DateTime?
  isVerified   Boolean        @default(false)
  lastName     String?
  firstName    String?
  sex          Sex?
  age          Int?
  role         Role
  memberType   MemberType?
  avatarUrl    String?
  points       Int            @default(0)
  pointHistory PointHistory[]
  createdAt    DateTime       @default(now())
}

model PointHistory {
  id        String   @id @default(uuid())
  amount    Int
  reason    String
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Sex {
  M
  F
}

enum Role {
  USER
  SUPER_USER
  ADMIN
}

enum MemberType {
  STUDENT
}
