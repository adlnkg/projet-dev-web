model Area {
  id          Int     @id @default(autoincrement())
  name        String
  description String?

  iotDevices IoTDevice[] @relation("AreaDevices")
  events Event[] @relation("AreaEvents")

  type          AreaType
  building      Building?      @relation("AreaBuilding")
  floor         Floor?         @relation("AreaFloor")
  classroom     Classroom?     @relation("AreaClassroom")
  technicalRoom TechnicalRoom? @relation("AreaTechnicalRoom")
}

enum AreaType {
  BUILDING
  FLOOR
  CLASSROOM
  TECHNICAL_ROOM
}

model Building {
  id      Int    @id @default(autoincrement())
  name    String
  address String

  floors Floor[] @relation("BuildingFloors")

  area   Area @relation("AreaBuilding", fields: [areaId], references: [id], onDelete: Cascade)
  areaId Int  @unique
}

model Classroom {
  id              Int @id @default(autoincrement())
  classroomNumber Int

  floor   Floor @relation("FloorClassrooms", fields: [floorId], references: [id], onDelete: Cascade)
  floorId Int

  whiteboards Whiteboard[] @relation("ClassroomWhiteboards")

  area   Area @relation("AreaClassroom", fields: [areaId], references: [id], onDelete: Cascade)
  areaId Int  @unique

  @@unique([floorId, classroomNumber])
  @@index([floorId])
}

model TechnicalRoom {
  id         Int @id @default(autoincrement())
  roomNumber Int

  floor   Floor @relation("FloorTechnicalRooms", fields: [floorId], references: [id], onDelete: Cascade)
  floorId Int

  area   Area @relation("AreaTechnicalRoom", fields: [areaId], references: [id], onDelete: Cascade)
  areaId Int  @unique

  @@unique([floorId, roomNumber])
  @@index([floorId])
}

model Floor {
  id          Int @id @default(autoincrement())
  floorNumber Int

  classrooms     Classroom[]     @relation("FloorClassrooms")
  technicalRooms TechnicalRoom[] @relation("FloorTechnicalRooms")

  building   Building @relation("BuildingFloors", fields: [buildingId], references: [id], onDelete: Cascade)
  buildingId Int

  area   Area @relation("AreaFloor", fields: [areaId], references: [id], onDelete: Cascade)
  areaId Int  @unique

  @@unique([buildingId, floorNumber])
  @@index([buildingId])
}
