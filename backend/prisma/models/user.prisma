model User {
  id             String         @id @default(uuid())
  login          String         @unique
  email          String         @unique
  password       String
  otp            String?
  otpExpires     DateTime?
  isVerified     Boolean        @default(false)
  lastName       String?
  firstName      String?
  sex            Sex?
  age            Int?
  role           Role
  memberType     MemberType?
  avatarUrl      String?
  createdAt      DateTime       @default(now())
  points         Int            @default(0)
  pointHistories PointHistory[]
}

enum Sex {
  M
  F
}

enum Role {
  USER
  SUPER_USER
  ADMIN
}

enum MemberType {
  STUDENT
  TEACHER
}

model PointHistory {
  id        String   @id @default(uuid())
  amount    Int
  reason    String
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}
